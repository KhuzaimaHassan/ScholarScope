# Export these variables in your shell; the application does not auto-load .env.
# Default fake provider makes no network calls. Choose a compatible model manually.
LLM_PROVIDER=fake
LLM_MODEL=fake-v1
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
LLM_CACHE_MODE=read_write
