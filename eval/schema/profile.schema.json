{
  "$defs": {
    "DocumentHeld": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DocumentHeld",
      "type": "object"
    },
    "GPAEntry": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "scale": {
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "title": "GPAEntry",
      "type": "object"
    },
    "LanguageScore": {
      "additionalProperties": false,
      "properties": {
        "test": {
          "minLength": 1,
          "title": "Test",
          "type": "string"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "sub_scores": {
          "anyOf": [
            {
              "additionalProperties": {
                "minimum": 0,
                "type": "number"
              },
              "propertyNames": {
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Scores"
        },
        "test_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Date"
        }
      },
      "required": [
        "test",
        "score"
      ],
      "title": "LanguageScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only data explicitly supplied by its owner; never an extraction input.\n\nNone is missing, distinct from 0 and empty text/mappings/collections. Empty\ntuples mean no entries supplied, not proof the owner holds none. No defaults\ninfer a degree, nationality, GPA scale, score, birth date or experience.",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "degree_level": {
      "anyOf": [
        {
          "enum": [
            "bachelor",
            "master",
            "phd",
            "postdoc",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degree Level"
    },
    "field_of_study": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field Of Study"
    },
    "gpas": {
